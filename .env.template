# Configuración de entorno del Sistema Integral de Gestión (G&T Logística)

# Copiá este archivo como `.env` y completá los valores antes de levantar el sistema
# por primera vez. 

# Contraseña del usuario administrador inicial (`admin`).
#
# OBLIGATORIA en la primera instalación: si no está definida y el usuario `admin`
# todavía no existe, el backend se detiene al arrancar con un mensaje explícito.

# Una vez creado el administrador, esta variable deja de ser necesaria y podés
# borrarla: la contraseña ya vive hasheada en la base de datos.
GT_ADMIN_PASSWORD_INICIAL=

# Contraseña del usuario `sa` de SQL Server en el entorno de desarrollo local.
# Debe tener al menos 8 caracteres e incluir mayúsculas, minúsculas y números.
GT_SQL_PASSWORD=

# Servidor de correo saliente, usado para enviar la contraseña temporal cuando el
# responsable de sistemas restablece la contraseña de un usuario (Módulo 2).
#
# OPCIONALES. Si `GT_CORREO_HOST` queda vacío, el sistema NO envía correo: registra
# el destinatario y el asunto en el log del backend (nunca la contraseña) y todo lo
# demás funciona igual. Es lo esperado en desarrollo, y alcanza para validar el
# módulo completo.
GT_CORREO_HOST=
GT_CORREO_PUERTO=587
GT_CORREO_USUARIO=
GT_CORREO_PASSWORD=
GT_CORREO_REMITENTE=sistema@gtlogistica.com.ar

# Carpeta donde el backend guarda los escaneos de la documentación de los choferes
# (Módulo 3): licencia de conducir, LiNTI, psicofísico, ART.
#
# OPCIONAL. El valor por defecto apunta al volumen que define `docker-compose.yml`,
# así que en desarrollo no hace falta tocarla. Es una carpeta interna del contenedor,
# fuera de la raíz web: los archivos nunca se sirven como contenido estático, sólo
# por un endpoint que exige sesión y el permiso del módulo.
GT_ARCHIVOS_RUTA=/var/gt/archivos
